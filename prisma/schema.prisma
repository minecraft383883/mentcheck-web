generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  THERAPIST
}

enum Mood {
  alegria
  tristeza
  enojo
  miedo
  tedio
  ansiedad
  no_lo_se
}

enum ReminderType {
  medicacion
  actividad
  cita
  personalizado
}

enum ReminderStatus {
  pendiente
  completado
}

enum AppointmentStatus {
  pendiente
  completada
  cancelada
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String
  role             Role              @default(PATIENT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patientProfile   PatientProfile?
  therapistProfile TherapistProfile?
  accounts         Account[]
  sessions         Session[]
}

model PatientProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  phone            String?
  birthdate        DateTime?
  therapistId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContact EmergencyContact?
  diaryEntries     DiaryEntry[]
  reminders        Reminder[]
  therapists       TherapistPatient[]
  appointments     Appointment[]
  sessionNotes     SessionNote[]
}

model TherapistProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCodes      InviteCode[]
  patients         TherapistPatient[]
  appointments     Appointment[]
  sessionNotes     SessionNote[]
}

model EmergencyContact {
  id               String         @id @default(cuid())
  patientProfileId String         @unique
  name             String
  phone            String
  relationship     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id               String         @id @default(cuid())
  patientProfileId String
  date             DateTime       @db.Date
  mood             Mood
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([patientProfileId, date])
}

model Reminder {
  id               String         @id @default(cuid())
  patientProfileId String
  type             ReminderType
  title            String
  time             String
  repeat           Boolean        @default(false)
  status           ReminderStatus @default(pendiente)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                 String            @id @default(cuid())
  therapistProfileId String
  patientProfileId   String
  dateTime           DateTime
  status             AppointmentStatus @default(pendiente)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  therapistProfile   TherapistProfile  @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  patientProfile     PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model SessionNote {
  id                 String           @id @default(cuid())
  therapistProfileId String
  patientProfileId   String
  date               DateTime         @db.Date
  content            String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  patientProfile     PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InviteCode {
  id                 String            @id @default(cuid())
  code               String            @unique
  therapistProfileId String
  used               Boolean           @default(false)
  usedByProfileId    String?
  expiresAt          DateTime
  createdAt          DateTime          @default(now())

  therapistProfile   TherapistProfile  @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
}

model TherapistPatient {
  id                 String            @id @default(cuid())
  therapistProfileId String
  patientProfileId   String
  createdAt          DateTime          @default(now())

  therapistProfile   TherapistProfile  @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  patientProfile     PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([therapistProfileId, patientProfileId])
}
